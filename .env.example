# URL publique du site (canonique, sitemap, Open Graph). Obligatoire en production.
NEXT_PUBLIC_SITE_URL=https://www.exemple-garage.fr

# Garage actif (voir src/config/garages). Par défaut : midas-villeurbanne-zola
GARAGE_ID=midas-villeurbanne-zola

# --- Transmission des demandes de rendez-vous / devis -------------------------
# Option A : e-mail via Resend (https://resend.com) — domaine expéditeur à vérifier chez Resend
RESEND_API_KEY=
LEAD_EMAIL_FROM="Site web <rdv@exemple-garage.fr>"
LEAD_EMAIL_TO=atelier@exemple-garage.fr

# Option B : webhook (Make, Zapier, n8n, CRM…) — reçoit le JSON de la demande en POST
LEAD_WEBHOOK_URL=
# Secret optionnel envoyé dans l'en-tête X-Webhook-Secret
LEAD_WEBHOOK_SECRET=
